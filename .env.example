# FinBERT sentiment threshold; labels are positive above and negative below ±threshold.
SENTIMENT_THRESHOLD=0.15
# Maximum number of fetched headlines per ticker.
MAX_NEWS_ITEMS=10
# Google News RSS request timeout in seconds.
NEWS_HTTP_TIMEOUT=10
NEWS_USER_AGENT=stock-pipeline/1.0
FINBERT_MODEL_NAME=ProsusAI/finbert
# In-memory API response cache lifetime in seconds.
CACHE_TTL_SECONDS=300
